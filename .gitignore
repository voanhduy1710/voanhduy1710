# ---------------------------------------------------------------------------
# Website (web/): merged from the former web/.gitignore. Its slash-free rules
# matched at any depth under web/, hence web/**/; its anchored rules are
# re-anchored at /web/. web/.vercelignore is what the Vercel CLI reads.
# ---------------------------------------------------------------------------

# dependencies
/web/node_modules
/web/.pnp
web/**/.pnp.*
/web/.yarn/*
!/web/.yarn/patches
!/web/.yarn/plugins
!/web/.yarn/releases
!/web/.yarn/versions

# testing
/web/coverage

# next.js / production output
/web/.next/
/web/out/
/web/build

# misc
web/**/*.pem

# debug
web/**/yarn-error.log*
web/**/.pnpm-debug.log*

# env files (web/.env.example stays tracked)
web/**/.env*
!web/**/.env.example

# typescript
web/**/*.tsbuildinfo
web/**/next-env.d.ts

# portfolio synced content (root-anchored: web/src/lib/content is source code)
/web/content/
/web/public/content/
/web/.sync-staging-*/
/web/.sync-lock

# local helper: project tree dump script and its output (never published)
/web/project_structure.py
/web/Project_structure.txt

# python bytecode cache
__pycache__/
*.py[cod]

# Owner's temporary Supabase login (local only, delete after changing the password)
/web/.owner-login.local.txt
