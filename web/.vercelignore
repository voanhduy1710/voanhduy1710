# When present, the Vercel CLI uses this file instead of .gitignore, so it mirrors the web/ rules of the repo-root .gitignore.

# env files / secrets
.env*
*.pem

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# testing
/coverage

# next.js build output
/.next/
/out/
/build

# portfolio synced content (regenerated by the prebuild sync on Vercel)
/content/
/public/content/
/.sync-staging-*/
/.sync-lock

# local-only
.vercel
.DS_Store
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local dev helpers (not part of the site)
project_structure.py
project_tester.py
Project_structure.txt
