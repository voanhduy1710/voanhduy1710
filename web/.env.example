VERCEL_ACCESS_TOKEN=

# Contact form (POST /api/contact): emails through Resend and saves to Supabase (public.contact_messages).
# Either can be left empty (that side is skipped); with neither key the form shows an email fallback.
# deploy_vercel.ps1 copies these to the Vercel production environment.
RESEND_API_KEY=
# Recipient; default voanhduy1710@gmail.com
CONTACT_TO=
# Sender; default "Portfolio <onboarding@resend.dev>" (a verified Resend domain is needed for other senders)
CONTACT_FROM=
# Supabase secret key (server-only, sb_secret_...; never NEXT_PUBLIC_). Sent as the apikey header only.
SUPABASE_SECRET_KEY=
# Default https://sudfxyhjksqjmarwcevp.supabase.co
SUPABASE_URL=

# Protects GET /api/keepalive (daily Vercel Cron that keeps the Supabase project awake). Vercel sends it as
# Authorization: Bearer <CRON_SECRET>. Any long random string.
CRON_SECRET=

# Optional: GitHub token for listing the Certifications repo during the content sync (avoids the 60 requests/hour
# unauthenticated API limit; jsDelivr is used as a fallback anyway).
GITHUB_TOKEN=

# Owner login (account menu) + owner-only CV colour, in the browser: the curriculum-vitae project's URL and its
# PUBLISHABLE key (sb_publishable_..., public by design; RLS on public.cv_preferences guards the data). Never put the
# secret key here. Inlined at build time; deploy_vercel.ps1 copies them to Vercel. Leave empty = no Log in item.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
